// use prisma-8
model PasswordResetToken {
  id          String   @id @default(uuid())

  user        User     @relation(fields:[userId], references:[id], onDelete: Cascade)
  userId      String

  tokenHash   String   @unique
  expiresAtMs String
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("passwordResetToken")
}

model User {
  id            String               @id @default(uuid())
  name          String?
  email         String               @unique
  password      String
  avatar        String?
  createdAt     DateTime             @default(now())
  updatedAt     temporal.updatedAt()

  videos        Video[]
  likes         Like[]
  comments      Comment[]
  commentReactions CommentReaction[]
  subscriptions Subscription[]       @relation("UserSubscriptions")
  subscribers   Subscription[]       @relation("ChannelSubscribers")
  watchHistory  WatchHistory[]
  watchLater    WatchLater[]
  downloads     Download[]

  plan          UserPlan?

  @@map("user")
}

model Video {
  id           String   @id @default(uuid())
  title        String
  description  String?
  thumbnail    String?
  isShort      Boolean  @default(false)
  videoUrl     String?
  category     String?
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    temporal.updatedAt()

  uploader     User     @relation(fields:[uploaderId], references:[id])
  uploaderId   String

  frames       VideoFrame[]
  likes        Like[]
  comments     Comment[]
  watchHistory WatchHistory[]
  watchLater   WatchLater[]
  downloads    Download[]

  @@map("video")
}

model VideoFrame {
  id        String   @id @default(uuid())
  imageUrl  String
  order     Int
  duration  Int      @default(2)
  createdAt temporal.createdAtString()

  video     Video    @relation(fields:[videoId], references:[id], onDelete: Cascade)
  videoId   String

  @@unique([videoId, order])
  @@map("videoFrame")
}

model Like {
  id        String   @id @default(uuid())
  createdAt temporal.createdAtString()

  user      User     @relation(fields:[userId], references:[id], onDelete: Cascade)
  userId    String

  video     Video    @relation(fields:[videoId], references:[id], onDelete: Cascade)
  videoId   String

  @@unique([userId, videoId])
  @@map("like")
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAtString()

  user      User     @relation(fields:[userId], references:[id], onDelete: Cascade)
  userId    String

  video     Video    @relation(fields:[videoId], references:[id], onDelete: Cascade)
  videoId   String

  parent    Comment?  @relation("CommentReplies", fields:[parentId], references:[id], onDelete: Cascade)
  parentId  String?

  replies   Comment[] @relation("CommentReplies")

  reactions CommentReaction[]

  @@index([videoId, createdAt])
  @@index([parentId])
  @@index([userId])
  @@map("comment")
}

model CommentReaction {
  id        String   @id @default(uuid())
  type      String
  createdAt DateTime @default(now())

  user      User     @relation(fields:[userId], references:[id], onDelete: Cascade)
  userId    String

  comment   Comment  @relation(fields:[commentId], references:[id], onDelete: Cascade)
  commentId String

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("commentReaction")
}

model Subscription {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())

  subscriber   User     @relation("UserSubscriptions", fields:[subscriberId], references:[id], onDelete: Cascade)
  subscriberId String

  channel      User     @relation("ChannelSubscribers", fields:[channelId], references:[id], onDelete: Cascade)
  channelId    String

  @@unique([subscriberId, channelId])
  @@map("subscription")
}

model WatchHistory {
  id        String   @id @default(uuid())
  watchedAt DateTime @default(now())

  user      User     @relation(fields:[userId], references:[id], onDelete: Cascade)
  userId    String

  video     Video    @relation(fields:[videoId], references:[id], onDelete: Cascade)
  videoId   String

  @@unique([userId, videoId])
  @@map("watchHistory")
}

model WatchLater {
  id        String   @id @default(uuid())
  createdAt temporal.createdAtString()

  user      User     @relation(fields:[userId], references:[id], onDelete: Cascade)
  userId    String

  video     Video    @relation(fields:[videoId], references:[id], onDelete: Cascade)
  videoId   String

  @@unique([userId, videoId])
  @@map("watchLater")
}

model UserPlan {
  id        String   @id @default(uuid())

  user      User     @relation(fields:[userId], references:[id], onDelete: Cascade)
  userId    String   @unique

  plan      String   @default("FREE")
  status    String   @default("ACTIVE")

  startDate   DateTime  @default(now())
  expiryDate  DateTime?
  renewalDate DateTime?

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature  String?

  amount   Int?
  currency String? @default("INR")

  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()

  @@map("userPlan")
}

model Download {
  id        String   @id @default(uuid())

  user      User     @relation(fields:[userId], references:[id], onDelete: Cascade)
  userId    String

  video     Video    @relation(fields:[videoId], references:[id], onDelete: Cascade)
  videoId   String

  downloadedAt DateTime @default(now())

  status String @default("COMPLETED")

  plan String @default("FREE")

  fileName String?
  fileSize Int?
  fileUrl  String?

  ipAddress   String?
  deviceType  String?
  deviceModel String?
  browser     String?
  userAgent   String?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([userId, downloadedAt])
  @@index([videoId, downloadedAt])
  @@index([userId, videoId])
  @@map("download")
}

model CommentReport {
  id        String   @id @default(uuid())

  comment   Comment  @relation(fields:[commentId], references:[id], onDelete: Cascade)
  commentId String

  reporter   User   @relation(fields:[reporterId], references:[id], onDelete: Cascade)
  reporterId String

  reason      String
  description String?

  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([commentId])
  @@index([reporterId])
  @@index([status])
  @@unique([commentId, reporterId])
  @@map("commentReport")
}